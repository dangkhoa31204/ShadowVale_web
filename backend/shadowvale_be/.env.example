# Copy this file to ".env" and fill in the real values. Never commit the real file.
# The API looks for ".env" in the folder it runs from and then in every parent folder, so the file can sit
# here, at the repository root, or outside the repository altogether.
# Names are the configuration keys with ":" written as "__". Real environment variables always win.

# Supabase -> Connect -> Session pooler (port 5432)
ConnectionStrings__Default=Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<db-password>;SSL Mode=Require

# Random strings, at least 32 characters each
Jwt__Key=<random string>
Game__ApiKeys__0=<random string>

# Optional: only to create the first Admin on an empty database, then remove
# SeedAdmin__Username=admin
# SeedAdmin__Email=admin@shadowvale.dev
# SeedAdmin__Password=<strong password>
